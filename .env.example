# Copy this file to .env and fill in real values before running the project.
# ------------------------------------------------------------
# PostgreSQL / app database
# ------------------------------------------------------------
POSTGRES_DB=tech_news_db
POSTGRES_USER=tech_admin
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=15432
DATABASE_URL=postgresql://tech_admin:change_me_postgres_password@postgres:5432/tech_news_db

# ------------------------------------------------------------
# Backend / frontend
# ------------------------------------------------------------
BACKEND_PORT=18080
FRONTEND_PORT=13000

# ------------------------------------------------------------
# Airflow metadata DB and admin UI
# ------------------------------------------------------------
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_PORT=18088
AIRFLOW_SECRET_KEY=change_me_airflow_secret_key
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres:5432/airflow


# ------------------------------------------------------------
# LLM enrichment step 3
# ------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
ENRICH_LIMIT=10

# ------------------------------------------------------------
# Qdrant & Vectorization (Step 04)
# ------------------------------------------------------------
QDRANT_HOST=qdrant_db
QDRANT_PORT=6333
QDRANT_COLLECTION=news_articles
GEMINI_EMBEDDING_MODEL=text-embedding-004
VECTORIZE_BATCH_LIMIT=20


